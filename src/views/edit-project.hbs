{{> header}}
<section class="bg-body-secondary py-5">
  <div class="container py-3">
    <div class="myproject-form-wrap mx-auto">
      <h2 class="text-center fw-bold mb-5">EDIT PROJECT</h2>
      <form action="/myproject/edit/{{project.id}}" method="POST">
        <div class="mb-4">
          <label class="form-label fw-bold mb-2 fs-4">Project Name</label>
          <input type="text" name="pname" value="{{project.name}}" class="form-control form-control-lg shadow-sm border-0" required>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-bold mb-2 fs-4">Start Date</label>
            <input type="date" name="pstart" value="{{formatDateInput project.start_date}}" class="form-control form-control-lg shadow-sm border-0">
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold mb-2 fs-4">End Date</label>
            <input type="date" name="pend" value="{{formatDateInput project.end_date}}" class="form-control form-control-lg shadow-sm border-0">
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold mb-2 fs-4">Description</label>
          <textarea name="pdesc" rows="6" class="form-control shadow-sm border-0">{{project.description}}</textarea>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold mb-2 fs-4">Technologies</label>
          <div class="row g-2">
            <div class="col-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="tech" value="Node JS" id="edit-node" {{#if (hasTech project.technologies "Node JS")}}checked{{/if}}>
                <label class="form-check-label ms-2 fs-4" for="edit-node">Node Js</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="tech" value="React JS" id="edit-react" {{#if (hasTech project.technologies "React JS")}}checked{{/if}}>
                <label class="form-check-label ms-2 fs-4" for="edit-react">React Js</label>
              </div>
            </div>
            <div class="col-6">
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="tech" value="Next JS" id="edit-next" {{#if (hasTech project.technologies "Next JS")}}checked{{/if}}>
                <label class="form-check-label ms-2 fs-4" for="edit-next">Next Js</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="tech" value="TypeScript" id="edit-ts" {{#if (hasTech project.technologies "TypeScript")}}checked{{/if}}>
                <label class="form-check-label ms-2 fs-4" for="edit-ts">TypeScript</label>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-5">
          <label class="form-label fw-bold mb-2 fs-4">Upload Image</label>
          <div class="input-group shadow-sm rounded-2 overflow-hidden myproject-upload">
            <label class="input-group-text border-0 bg-secondary-subtle text-secondary px-4 py-2" for="inputImageEdit">choose</label>
            <div class="form-control text-secondary" id="imageFileNameEdit">Current image</div>
            <span class="input-group-text bg-white border-0 text-dark">
              <i class="fa-solid fa-paperclip"></i>
            </span>
            <input type="file" id="inputImageEdit" accept="image/*" hidden>
            <input type="hidden" name="imageData" id="imageDataEdit" value="{{project.image}}">
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/myproject" class="btn btn-outline-dark rounded-pill px-4">cancel</a>
          <button type="submit" class="btn btn-dark rounded-pill px-5 py-2 fw-semibold">save</button>
        </div>
      </form>
    </div>
  </div>
</section>
<script src="/assets/scripts/project-image.js"></script>
{{> footer}}
