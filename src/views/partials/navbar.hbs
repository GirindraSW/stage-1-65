<nav class="navbar navbar-expand-lg navbar-light bg-warning mb-0 shadow-sm">
  <div class="container">
    <a class="navbar-brand" href="/home"><img src="/assets/images/brandwhite.png" alt="DumbWays.ID" width="30" height="24"></a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link {{#ifEquals active 'home'}}active fw-bold{{/ifEquals}}" href="/home">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#ifEquals active 'project'}}active fw-bold{{/ifEquals}}" href="/myproject">
            My Projects
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link {{#ifEquals active 'contact'}}active fw-bold{{/ifEquals}}" href="/contact">Contact Me</a>
        </li>
      </ul>
