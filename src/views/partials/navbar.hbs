          <button type="submit" class="btn btn-dark btn-sm">Logout</button>
        </form>
      {{else}}
        <div class="d-flex gap-2">
          <a class="btn btn-outline-dark btn-sm {{#ifEquals active 'login'}}active{{/ifEquals}}" href="/login">Login</a>
          <a class="btn btn-dark btn-sm {{#ifEquals active 'register'}}active{{/ifEquals}}" href="/register">Register</a>
