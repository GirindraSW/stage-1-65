{{> header}}
<div class="myproject-page">
  <section class="bg-body-secondary py-5">
    <div class="container py-3">
      <div class="myproject-form-wrap mx-auto">
        <h2 class="text-center fw-bold mb-5">ADD MY PROJECT</h2>
        <form action="/myproject" method="POST" enctype="multipart/form-data">
          <div class="mb-4">
            <label class="form-label fw-bold mb-2 fs-4">Project Name</label>
            <input type="text" name="pname" class="form-control form-control-lg shadow-sm border-0">
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6">
              <label class="form-label fw-bold mb-2 fs-4">Start Date</label>
              <input type="date" name="pstart" class="form-control form-control-lg shadow-sm border-0">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-bold mb-2 fs-4">End Date</label>
              <input type="date" name="pend" class="form-control form-control-lg shadow-sm border-0">
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label fw-bold mb-2 fs-4">Description</label>
            <textarea name="pdesc" rows="6" class="form-control shadow-sm border-0"></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label fw-bold mb-2 fs-4">Technologies</label>
            <div class="row g-2">
              <div class="col-6">
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" name="tech" value="Node JS" id="node">
                  <label class="form-check-label ms-2 fs-4" for="node">Node Js</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="tech" value="React JS" id="react">
                  <label class="form-check-label ms-2 fs-4" for="react">React Js</label>
                </div>
              </div>
              <div class="col-6">
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" name="tech" value="Next JS" id="next">
                  <label class="form-check-label ms-2 fs-4" for="next">Next Js</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="tech" value="TypeScript" id="ts">
                  <label class="form-check-label ms-2 fs-4" for="ts">TypeScript</label>
                </div>
              </div>
            </div>
          </div>

          <div class="mb-5">
            <label class="form-label fw-bold mb-2 fs-4">Upload Image</label>
            <div class="input-group shadow-sm rounded-2 overflow-hidden myproject-upload">
              <label class="input-group-text border-0 bg-secondary-subtle text-secondary px-4 py-2" for="inputImage">choose</label>
              <div class="form-control text-secondary" id="imageFileName">No file chosen</div>
              <span class="input-group-text bg-white border-0 text-dark">
                <i class="fa-solid fa-paperclip"></i>
              </span>
              <input type="file" id="inputImage" name="image" accept="image/*" hidden>
            </div>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-dark rounded-pill px-5 py-2 fw-semibold">submit</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-light py-5">
    <div class="container">
      <h2 class="text-center fw-bold mb-5">MY PROJECT</h2>
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-1">
        {{#each projects}}
        <div class="col">
          <div class="card h-100 shadow-sm border-0 rounded-3">
            <a href="/project-detail/{{this.id}}" class="text-decoration-none text-dark">
              <img src="{{this.image}}" class="card-img-top rounded-top-3 myproject-card-image" alt="Project Image">
            </a>
            <div class="card-body">
              <a href="/project-detail/{{this.id}}" class="text-decoration-none text-dark">
                <h5 class="card-title fw-bold mb-1">{{this.name}}</h5>
                <p class="text-muted small mb-3">{{formatDate this.start_date}} - {{formatDate this.end_date}}</p>
                <p class="card-text text-secondary mb-4 myproject-desc">{{this.description}}</p>
              </a>
              <div class="d-flex align-items-center gap-3 fs-5 mb-4">
                <i class="fa-brands fa-google-play"></i>
                <i class="fa-brands fa-android"></i>
                <i class="fa-brands fa-java"></i>
              </div>
              <div class="d-flex gap-2">
                <a href="/myproject/edit/{{this.id}}" class="btn btn-dark btn-sm rounded-2 flex-fill">edit</a>
                <form action="/myproject/delete/{{this.id}}" method="POST" class="flex-fill">
                  <button type="submit" class="btn btn-dark btn-sm rounded-2 w-100">delete</button>
                </form>
              </div>
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
</div>

<script src="/assets/scripts/project-image.js"></script>
{{> footer}}
